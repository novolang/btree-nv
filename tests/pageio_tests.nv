// pageio_tests.nv — the drivers over a page store with no machine
// behind it.
//
// `Table` answers reads from a fixed list of pages and accepts every
// write, allocation and release without keeping anything, so a walk
// over it costs nothing: its implementation is `PageIo[]`, and these
// tests declare no effect for the walk.  `Refusing` fails whichever
// operation it is told to.

use std.test
use btcell
use nodefmt
use btree
use pageio

struct Held
    id: Int
    bytes: [Int]

struct Table
    slots: [Held]
    // 0: nothing fails; 1: stores fail; 2: allocations fail.
    refuse: Int

impl PageIo[] for Table
    fn fetch(self, page_id: Int) -> Result<[Int], IoFault>
        for s in self.slots
            if s.id == page_id
                return Ok(s.bytes[:])
        Err(ReadFailed(page_id: page_id, why: "no such page"))

    fn store(self, page_id: Int, bytes: [Int]) -> Result<Unit, IoFault>
        if self.refuse == 1
            return Err(WriteFailed(page_id: page_id, why: "read-only"))
        Ok(())

    fn allocate(self, kind: Int) -> Result<Int, IoFault>
        if self.refuse == 2
            return Err(AllocFailed(why: "full"))
        Ok(100 + kind)

    fn release(self, page_id: Int) -> Result<Unit, IoFault>
        Ok(())

fn leaf_page(id: Int, keys: [Int]) -> [Int]
    var rows: [[btcell.Cell]] = []
    for k in keys
        list.push(rows, [btcell.of_int(k * 10)])
    match nodefmt.encode_leaf(id, Leaf { keys: keys, rows: rows })
        Ok(b)  => b
        Err(_) => []

fn inner_page(id: Int, seps: [Int], kids: [Int]) -> [Int]
    match nodefmt.encode_inner(id, Inner { separators: seps, children: kids })
        Ok(b)  => b
        Err(_) => []

fn keys_to(n: Int) -> [Int]
    var out: [Int] = []
    for k in 0..n
        list.push(out, k)
    out

// A root inner page 1 over leaves 2 (keys 0 and 1) and 3 (key 5).
fn two_leaves(refuse: Int) -> Table
    Table { slots: [Held { id: 1, bytes: inner_page(1, [5], [2, 3]) },
        Held { id: 2, bytes: leaf_page(2, [0, 1]) }, Held { id: 3, bytes: leaf_page(3, [5]) }],
        refuse: refuse }

@test
fn test_run_scans_every_row_with_its_key()
    match pageio.run(two_leaves(0), btree.scan(btree.open(1, 3, 2)))
        Ok(out) =>
            test.assert_eq(out.keys, [0, 1, 5])
            test.assert_eq(list.len(out.rows), 3)
            test.assert_eq(out.rows_affected, 3)
            test.assert_eq(out.tree.size, 3)
        Err(f)  => test.fail(f.message())

@test
fn test_run_answers_an_insert_s_allocations_and_writes()
    let full = Table { slots: [Held { id: 1, bytes: leaf_page(1, keys_to(16)) }], refuse: 0 }
    match pageio.run(full, btree.insert(btree.open(1, 16, 1), 16, [btcell.of_int(1)]))
        Ok(out) =>
            // The leaf split, and the new root is the inner page the
            // table handed out.
            test.assert_eq(out.tree.root, 107)
            test.assert_eq(out.tree.height, 2)
            test.assert_eq(out.rows_affected, 1)
        Err(f)  => test.fail(f.message())

@test
fn test_run_answers_a_delete_s_frees()
    match pageio.run(two_leaves(0), btree.delete(btree.open(1, 3, 2), 5))
        Ok(out) =>
            // Leaf 3 emptied and the root gave way to leaf 2.
            test.assert_eq(out.tree.root, 2)
            test.assert_eq(out.tree.height, 1)
        Err(f)  => test.fail(f.message())

@test
fn test_a_request_the_host_cannot_answer_is_its_fault()
    match pageio.run(two_leaves(0), btree.lookup(btree.open(7, 1, 1), 1))
        Ok(_)  => test.fail("page 7 is not in the table")
        Err(f) => test.assert_eq(f.message(), "pageio: page 7 could not be read: no such page")
    match pageio.run(two_leaves(1), btree.insert(btree.open(1, 3, 2), 9, [btcell.null_cell()]))
        Ok(_)  => test.fail("the table refuses writes")
        Err(f) => test.assert_eq(f.message(), "pageio: page 3 could not be written: read-only")
    let full = Table { slots: [Held { id: 1, bytes: leaf_page(1, keys_to(16)) }], refuse: 2 }
    match pageio.run(full, btree.insert(btree.open(1, 16, 1), 16, [btcell.of_int(1)]))
        Ok(_)  => test.fail("the table has no pages to give")
        Err(f) => test.assert_eq(f.message(), "pageio: no page could be allocated: full")

@test
fn test_a_walk_that_stops_on_its_own_is_a_walk_fault()
    let wrong = Table { slots: [Held { id: 1, bytes: leaf_page(9, []) }], refuse: 0 }
    match pageio.run(wrong, btree.scan(btree.open(1, 0, 1)))
        Ok(_)  => test.fail("page 1 says it is page 9")
        Err(f) => test.assert_eq(f.message(), "btree: page 1: nodefmt: the page says it is 9, and 1 was asked for")
    match pageio.next_row(wrong, btree.scan(btree.open(1, 0, 1)))
        Ok(_)  => test.fail("page 1 says it is page 9")
        Err(f) => test.assert_eq(str.starts_with(f.message(), "btree: page 1"), true)
    match pageio.next_row(two_leaves(0), btree.scan(btree.open(4, 0, 1)))
        Ok(_)  => test.fail("page 4 is not in the table")
        Err(f) => test.assert_eq(f.message(), "pageio: page 4 could not be read: no such page")

@test
fn test_next_row_stops_at_each_row_and_answers_none_at_the_end()
    let t = two_leaves(0)
    var keys: [Int] = []
    var c = btree.scan(btree.open(1, 3, 2))
    var going = true
    loop
        if not going
            break
        match pageio.next_row(t, c)
            Ok(r)  =>
                match r
                    Some(hit) =>
                        list.push(keys, hit.key)
                        test.assert_eq(btcell.as_int(hit.row[0]) ?? 0, hit.key * 10)
                        c = hit.cursor
                    None      =>
                        going = false
            Err(f) =>
                test.fail(f.message())
                going = false
    test.assert_eq(keys, [0, 1, 5])
