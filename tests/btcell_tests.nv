// btcell_tests.nv — the five storage classes, their bytes, and the
// refusals of a buffer that is not a cell.

use std.test
use btcell

fn blob_of(c: Cell) -> [Int]
    match btcell.as_blob(c)
        Some(b) => b
        None    => [0 - 1]

@test
fn test_constructors_and_accessors_round_trip()
    // Each accessor answers for its own class and `None` for the rest.
    test.assert_eq(btcell.as_int(btcell.of_int(42)) ?? 0, 42)
    test.assert_eq(btcell.as_str(btcell.of_str("hi")) ?? "", "hi")
    test.assert_none(btcell.as_int(btcell.of_str("hi")))
    test.assert_none(btcell.as_str(btcell.of_int(1)))

@test
fn test_float_and_blob_round_trip()
    test.assert_eq(btcell.as_float(btcell.of_float(1.5)) ?? 0.0, 1.5)
    test.assert_eq(blob_of(btcell.of_blob([1, 2, 255])), [1, 2, 255])
    test.assert_none(btcell.as_float(btcell.of_blob([0])))
    test.assert_eq(blob_of(btcell.of_int(1)), [0 - 1])

@test
fn test_null_is_the_only_null()
    test.assert_true(btcell.is_null(btcell.null_cell()), "the null cell is null")
    test.assert_false(btcell.is_null(btcell.of_int(0)), "zero is not null")
    test.assert_false(btcell.is_null(btcell.of_str("")), "the empty string is not null")

@test
fn test_tag_is_the_documented_byte()
    test.assert_eq(btcell.tag(btcell.null_cell()), 0)
    test.assert_eq(btcell.tag(btcell.of_int(1)), 1)
    test.assert_eq(btcell.tag(btcell.of_float(1.0)), 2)
    test.assert_eq(btcell.tag(btcell.of_str("a")), 3)
    test.assert_eq(btcell.tag(btcell.of_blob([0])), 4)

@test
fn test_each_cell_is_the_documented_bytes()
    test.assert_eq(btcell.encode_cell([], btcell.of_int(0 - 2)), [1, 255, 255, 255, 255, 255, 255, 255, 254])
    test.assert_eq(btcell.encode_cell([], btcell.of_float(1.0)), [2, 63, 240, 0, 0, 0, 0, 0, 0])
    test.assert_eq(btcell.encode_cell([9], btcell.of_str("é")), [9, 3, 0, 0, 0, 2, 195, 169])
    test.assert_eq(btcell.encode_cell([], btcell.of_blob([7])), [4, 0, 0, 0, 1, 7])
    test.assert_eq(btcell.encode_cell([], btcell.null_cell()), [0])
    test.assert_eq(btcell.encode_row([], []), [0, 0, 0, 0])

@test
fn test_encoded_size_agrees_with_the_encoder()
    let row = [btcell.of_int(1), btcell.null_cell(), btcell.of_str("x"), btcell.of_float(2.0),
        btcell.of_blob([1, 2])]
    for c in row
        test.assert_eq(list.len(btcell.encode_cell([], c)), btcell.encoded_size(c))
    test.assert_eq(list.len(btcell.encode_row([], row)), btcell.encoded_row_size(row))

@test
fn test_encode_then_decode_is_the_identity()
    let row = [btcell.of_int(0 - 1), btcell.of_float(2.5), btcell.of_str("eé€😀\u{d7ff}\u{10ffff}\u{800}\u{10000}"),
        btcell.of_blob([0, 255]), btcell.null_cell()]
    match btcell.decode_row(btcell.encode_row([], row), 0)
        Ok(at) =>
            test.assert_eq(btcell.show_row(at.row), btcell.show_row(row))
            test.assert_eq(at.next_offset, btcell.encoded_row_size(row))
        Err(e) => test.fail(e.message())

fn cell_error(buf: [Int]) -> Str
    match btcell.decode_cell(buf, 0)
        Ok(_)  => "no error"
        Err(e) => e.message()

@test
fn test_decode_names_the_offset_of_every_fault()
    test.assert_eq(cell_error([9]), "btcell: tag 9 at byte 0 is not a storage class")
    test.assert_eq(cell_error([]), "btcell: 1 byte(s) needed at byte 0, 0 left")
    test.assert_eq(cell_error([1, 0, 0]), "btcell: 8 byte(s) needed at byte 1, 2 left")
    test.assert_eq(cell_error([2, 0]), "btcell: 8 byte(s) needed at byte 1, 1 left")
    test.assert_eq(cell_error([3, 0, 0]), "btcell: 4 byte(s) needed at byte 1, 2 left")
    test.assert_eq(cell_error([3, 0, 0, 0, 5, 97]), "btcell: 5 byte(s) needed at byte 5, 1 left")
    test.assert_eq(cell_error([4, 0, 0, 0]), "btcell: 4 byte(s) needed at byte 1, 3 left")
    test.assert_eq(cell_error([4, 0, 0, 0, 3, 1]), "btcell: 3 byte(s) needed at byte 5, 1 left")
    test.assert_eq(cell_error([4, 0, 0, 0, 2, 1, 256]), "btcell: blob byte 256 at 6 is outside 0 to 255")
    test.assert_eq(cell_error([4, 0, 0, 0, 1, 0 - 1]), "btcell: blob byte -1 at 5 is outside 0 to 255")
    match btcell.decode_row([0, 0, 0, 1], 9)
        Ok(_)  => test.fail("an offset past the end")
        Err(e) => test.assert_eq(e.message(), "btcell: 4 byte(s) needed at byte 9, 0 left")

@test
fn test_text_must_be_utf8()
    // A lone continuation byte, an overlong form, a surrogate, a value
    // above U+10FFFF, a truncated sequence, an overlong four-byte form
    // and a bad second continuation byte.
    for bad in [[128], [192, 175], [237, 160, 128], [244, 144, 128, 128], [226, 130],
                [240, 128, 128, 128], [226, 130, 40], [255], [0 - 5]]
        var buf = [3, 0, 0, 0, list.len(bad)]
        list.append(buf, bad[:])
        test.assert_eq(cell_error(buf), "btcell: text is not UTF-8 at byte 5")

@test
fn test_show_renders_sql_text()
    test.assert_eq(btcell.show(btcell.of_int(7)), "7")
    test.assert_eq(btcell.show(btcell.null_cell()), "NULL")
    test.assert_eq(btcell.show(btcell.of_str("it's")), "'it''s'")
    test.assert_eq(btcell.show(btcell.of_blob([171, 205, 1])), "X'abcd01'")
    test.assert_eq(btcell.show(btcell.of_float(2.5)), "2.5")
    test.assert_eq(btcell.show_row([btcell.of_int(1), btcell.null_cell()]), "1, NULL")
