// The rendering is the one novodb's `show_cell` produces, which the
// SQL-logic-test corpus compares against.
pub fn show(c: Cell) -> Str
    todo("btree-nv.cell.show")

// A row as SQL text: `show` of each cell, separated by `, `.
pub fn show_row(row: [Cell]) -> Str
    todo("btree-nv.cell.show_row")
