// pageio.nv — the same walk, written as a loop instead of a protocol.
//
// `btree.step` hands the host a `PageRequest` and waits, which is the
// shape a host with an event loop, a batching reader or an asynchronous
// page store wants.  A host with a plain file wants a function call.
// This module is that: a trait with the host's four page operations,
// and two drivers that run a cursor over it.
//
// The trait binds one effect parameter, and each driver is charged
// whatever the implementation behind it costs (SPEC section 5.6).  A
// page store over a file supplies `[fs]`, and a test with its pages in
// memory supplies nothing.  Neither charge lands on this package.
//
// A caller that must interleave, batch or suspend walks uses
// `btree.step`, because `run` does not come back until the walk is
// over.

use btcell
use btree

// The four things a host can do with a page, and what each costs.
//
// An implementation supplies the effects its own operations cost:
// `impl PageIo[fs]` for a page store over a file, `impl PageIo[]` for
// one in memory.
pub trait PageIo[e]
    // The whole page stored under this id, header included.
    fn fetch(self, page_id: Int) -> Result<[Int], IoFault> [e]
    // Store these bytes under this id.
    fn store(self, page_id: Int, bytes: [Int]) -> Result<Unit, IoFault> [e]
    // Allocate a page of this kind and answer with its id.
    fn allocate(self, kind: Int) -> Result<Int, IoFault> [e]
    // Release a page that is no longer reachable.
    fn release(self, page_id: Int) -> Result<Unit, IoFault> [e]

// Everything a finished walk produced.
//
// `rows` and `keys` run parallel and are empty for an insert or a
// delete.  `tree` is the tree to keep, since an insert that split the
// root moved it.
pub struct Outcome
    rows: [[btcell.Cell]]
    keys: [Int]
    rows_affected: Int
    tree: btree.Tree

// Run a cursor to its end, answering every request it makes.
//
// The call costs what `S`'s own `PageIo` implementation costs.  A
// request the host cannot answer is its `IoFault`, and a walk that
// stops on its own is `Walk` with the tree's reason.
//
// ```novo
// use btree
// use pageio
//
// fn all_rows<S: pageio.PageIo[e]>(io: S, t: btree.Tree) -> Int [e]
//     match pageio.run(io, btree.scan(t))
//         Ok(out) => out.rows_affected
//         Err(f)  => 0
//
// fn main() [io]
//     println("a core walk, charged what the host's impl costs")
// ```
pub fn run<S: PageIo[e]>(io: S, start: btree.Cursor) -> Result<Outcome, IoFault> [e]
    var c = start
    var rows: [[btcell.Cell]] = []
    var keys: [Int] = []
    loop
        let p = btree.step(c)
        c = answer(io, p)!
        match p.step
            SRow(k, r)  =>
                list.push(keys, k)
                list.push(rows, r[:])
            SDone(n)    =>
                return Ok(Outcome { rows: rows, keys: keys, rows_affected: n, tree: btree.tree_of(c) })
            SFailed(e)  => return Err(Walk(cause: e))
            SRequest(_) => ()

// Perform the request a step made, if it made one, and answer the
// cursor to continue from.
fn answer<S: PageIo[e]>(host: S, p: btree.Progress) -> Result<btree.Cursor, IoFault> [e]
    let c = p.cursor
    let SRequest(q) = p.step else return Ok(c)
    match q
        PrNeedPage(id)    => Ok(btree.feed_page(c, id, host.fetch(id)!))
        PrWritePage(i, b) =>
            host.store(i, b)!
            Ok(c)
        PrAllocPage(k)    => Ok(btree.feed_alloc(c, host.allocate(k)!))
        PrFreePage(i)     =>
            host.release(i)!
            Ok(c)

// Run a cursor until its next row, so a caller can stop early.
//
// Answers `None` when the walk finished without another row.  A query
// that wants ten rows of a million stops after ten calls.
pub fn next_row<S: PageIo[e]>(io: S, c: btree.Cursor) -> Result<?NextRow, IoFault> [e]
    var cur = c
    loop
        let p = btree.step(cur)
        cur = answer(io, p)!
        match p.step
            SRow(k, r)  => return Ok(Some(NextRow { key: k, row: r[:], cursor: cur }))
            SDone(_)    => return Ok(None)
            SFailed(e)  => return Err(Walk(cause: e))
            SRequest(_) => ()

// One row, its key, and the cursor to continue from.
pub struct NextRow
    key: Int
    row: [btcell.Cell]
    cursor: btree.Cursor

// Why a driven walk stopped.
//
// A `BtreeError` is the tree saying the bytes were wrong, and the other
// arms are the host saying it could not do what was asked.  The first
// points at whatever wrote the pages, the others at the store.
pub enum IoFault
    // The host could not read this page.
    ReadFailed(page_id: Int, why: Str)
    // The host could not store this page.
    WriteFailed(page_id: Int, why: Str)
    // The host had no page to give — the store is full, or read-only.
    AllocFailed(why: Str)
    // The tree stopped on its own after the host did everything asked
    // of it.
    Walk(cause: btree.BtreeError)

// The one-line report of a driven walk that stopped.
impl Error for IoFault
    fn message(self) -> Str
        match self
            ReadFailed(p, why)  => "pageio: page ${p} could not be read: ${why}"
            WriteFailed(p, why) => "pageio: page ${p} could not be written: ${why}"
            AllocFailed(why)    => "pageio: no page could be allocated: ${why}"
            Walk(cause)         => cause.message()
